PUBLIC_MAPBOX_KEY=<replace me>
# Optional. Defaults to the production style, which only its owner's token can
# read. Otherwise use a public style such as mapbox://styles/mapbox/dark-v11
# PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/dark-v11
# Optional. Defaults to the production tile server. Use http://localhost:3500
# to see your local database (see "Local tile server" in the README).
# PUBLIC_TILESERVER_URL=http://localhost:3500
